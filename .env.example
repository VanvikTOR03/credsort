# Copy to .env (never commit .env). All values below are placeholders.
CREDSORT_ENV=dev
POSTGRES_PASSWORD=change-me
DB_PASSWORD_IDENTITY=change-me
DB_PASSWORD_ACCOUNTING=change-me
DB_PASSWORD_INTELLIGENCE=change-me
DB_PASSWORD_MARKETPLACE=change-me
DB_PASSWORD_BILLING=change-me
DB_PASSWORD_ADVISORY=change-me
DB_PASSWORD_NOTIFICATION=change-me
DB_PASSWORD_AUDIT=change-me
DB_PASSWORD_KEYCLOAK=change-me
RABBITMQ_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
WEB_CLIENT_SECRET=change-me
SERVICE_CLIENT_SECRET=change-me
SESSION_SECRET=change-me-32-chars-minimum-please
# bexio developer app (OAuth). Obtain from the bexio developer portal; keep only here.
BEXIO_CLIENT_ID=
BEXIO_CLIENT_SECRET=
# OpenAI-compatible LLM for the company assistant (Groq shown). Leave empty for template answers only.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Payment gateway for the one-off CHF 190 fee. "demo" only simulates success (refused in production).
PAYMENT_PROVIDER=demo
