{
  "$id": "credsort.marketplace.disclosure.revoked.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "application_id": {
      "pattern": "^[0-9a-fA-F-]{36}$",
      "type": "string"
    },
    "lender_org_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-fA-F-]{36}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "level": {
      "enum": [
        "summary",
        "full"
      ]
    },
    "sme_org_id": {
      "pattern": "^[0-9a-fA-F-]{36}$",
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "sme_org_id",
    "level"
  ],
  "title": "marketplace.disclosure.revoked",
  "type": "object"
}
