{
  "components": {
    "schemas": {
      "DelegationCreate": {
        "properties": {
          "fiduciary_org_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fiduciary Org Id"
          },
          "referral_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Referral Code"
          },
          "scopes": {
            "default": [
              "VIEW_PROFILE",
              "PREPARE_APPLICATION"
            ],
            "items": {
              "type": "string"
            },
            "title": "Scopes",
            "type": "array"
          }
        },
        "title": "DelegationCreate",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MemberAdd": {
        "properties": {
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "email",
          "display_name",
          "role"
        ],
        "title": "MemberAdd",
        "type": "object"
      },
      "OrgCreate": {
        "properties": {
          "employees": {
            "anyOf": [
              {
                "maximum": 100000.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Employees"
          },
          "industry": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Industry"
          },
          "legal_form": {
            "anyOf": [
              {
                "enum": [
                  "AG",
                  "GmbH",
                  "Other"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Form"
          },
          "legal_name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Legal Name",
            "type": "string"
          },
          "referral_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Referral Code"
          },
          "type": {
            "enum": [
              "SME",
              "LENDER",
              "FIDUCIARY"
            ],
            "title": "Type",
            "type": "string"
          },
          "uid": {
            "anyOf": [
              {
                "pattern": "^CHE-\\d{3}\\.\\d{3}\\.\\d{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Uid"
          }
        },
        "required": [
          "type",
          "legal_name"
        ],
        "title": "OrgCreate",
        "type": "object"
      },
      "TokenRequest": {
        "properties": {
          "on_behalf_of": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "On Behalf Of"
          },
          "org_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Org Id"
          }
        },
        "title": "TokenRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
