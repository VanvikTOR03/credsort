{
  "components": {
    "schemas": {
      "Activate": {
        "properties": {
          "effective_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Effective From"
          }
        },
        "title": "Activate",
        "type": "object"
      },
      "BookCreate": {
        "properties": {
          "placeholder": {
            "default": false,
            "title": "Placeholder",
            "type": "boolean"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/RuleIn"
            },
            "title": "Rules",
            "type": "array"
          }
        },
        "required": [
          "rules"
        ],
        "title": "BookCreate",
        "type": "object"
      },
      "EntitlementSet": {
        "properties": {
          "entitlements": {
            "items": {
              "type": "string"
            },
            "title": "Entitlements",
            "type": "array"
          },
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          }
        },
        "required": [
          "org_id",
          "entitlements"
        ],
        "title": "EntitlementSet",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "QuoteRequest": {
        "properties": {
          "action": {
            "const": "LOAN_FUNDED",
            "title": "Action",
            "type": "string"
          },
          "basis": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Basis"
          },
          "payer_org_id": {
            "format": "uuid",
            "title": "Payer Org Id",
            "type": "string"
          },
          "payer_type": {
            "enum": [
              "SME",
              "LENDER"
            ],
            "title": "Payer Type",
            "type": "string"
          },
          "subject_id": {
            "format": "uuid",
            "title": "Subject Id",
            "type": "string"
          }
        },
        "required": [
          "action",
          "subject_id",
          "payer_org_id",
          "payer_type",
          "basis"
        ],
        "title": "QuoteRequest",
        "type": "object"
      },
      "RuleIn": {
        "properties": {
          "amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "calculator": {
            "enum": [
              "FIXED",
              "PERCENT_OF_PRINCIPAL"
            ],
            "title": "Calculator",
            "type": "string"
          },
          "cap_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cap Amount"
          },
          "code": {
            "maxLength": 40,
            "minLength": 2,
            "title": "Code",
            "type": "string"
          },
          "min_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Amount"
          },
          "payer": {
            "enum": [
              "SME",
              "LENDER"
            ],
            "title": "Payer",
            "type": "string"
          },
          "percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Percent"
          },
          "trigger": {
            "default": "LOAN_FUNDED",
            "enum": [
              "LOAN_FUNDED",
              "MANUAL"
            ],
            "title": "Trigger",
            "type": "string"
          }
        },
        "required": [
          "code",
          "payer",
          "calculator"
        ],
        "title": "RuleIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
