            "anyOf": [
              {
                "pattern": "^\\d+(\\.\\d{1,2})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Debt Repayment From Cash"
          },
          "revenue_change_pct": {
            "anyOf": [
              {
                "pattern": "^-?\\d+(\\.\\d{1,2})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revenue Change Pct"
          }
        },
        "title": "ScenarioInputs",
        "type": "object"
      },
