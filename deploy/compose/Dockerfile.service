# One image recipe for every Python service: docker build --build-arg SERVICE=marketplace -f deploy/compose/Dockerfile.service .
FROM python:3.12-slim
ARG SERVICE
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 SERVICE=${SERVICE}
WORKDIR /srv
COPY libs/credsort-common /srv/libs/credsort-common
RUN pip install --no-cache-dir /srv/libs/credsort-common
COPY services/${SERVICE} /srv/service
WORKDIR /srv/service
ENV PYTHONPATH=/srv/service
RUN useradd --system --uid 10001 credsort && chown -R credsort /srv
USER credsort
CMD ["sh", "-c", "uvicorn app.main:app_factory --factory --host 0.0.0.0 --port ${PORT:-8000}"]
